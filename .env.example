# Copy to .env and replace every change-me value. Never commit .env.
POSTGRES_PASSWORD=change-me-database-password
DISPATCH_ADMIN_API_KEY=change-me-use-at-least-32-random-characters
DISPATCH_ENVIRONMENT=production
DISPATCH_ORGANIZATION_ID=default
DISPATCH_ORGANIZATION_NAME=Dispatch Core
DISPATCH_HTTP_PORT=8080

# Base compose starts with both providers disabled. To enable transports, copy
# compose.transports.example.yaml to a private override and create the token
# files under ./secrets with chmod 600.
TELEGRAM_RECEIVE_MODE=polling
MAX_RECEIVE_MODE=webhook
TELEGRAM_WEBHOOK_SECRET=change-me-telegram-webhook-secret
MAX_WEBHOOK_SECRET=change-me-max-webhook-secret
